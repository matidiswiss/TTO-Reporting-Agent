{
  "rewrites": [
    { "source": "/", "destination": "/preview/login.html" },
    { "source": "/login", "destination": "/preview/login.html" },
    { "source": "/login.html", "destination": "/preview/login.html" },
    { "source": "/dashboard", "destination": "/preview/index.html" },
    { "source": "/index.html", "destination": "/preview/index.html" },
    { "source": "/data.json", "destination": "/preview/data.json" },
    { "source": "/js/(.*)", "destination": "/preview/js/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
